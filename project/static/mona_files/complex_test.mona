#(F(goal_1) & F(goal_2) & F(goal_3) & F(goal_4) & G(!(goal_5)) & G(!(goal_6)));
var2 $ where ~ex1 p where true: p notin $ & p+1 in $;
allpos $;
var2 GOAL_1, GOAL_2, GOAL_3, GOAL_4, GOAL_5, GOAL_6;
((ex1 v_1: v_1 in $ & 0<=v_1&v_1<=max($) & (v_1 in GOAL_1)) & (ex1 v_2: v_2 in $ & 0<=v_2&v_2<=max($) & (v_2 in GOAL_2)) & (ex1 v_3: v_3 in $ & 0<=v_3&v_3<=max($) & (v_3 in GOAL_3)) & (ex1 v_4: v_4 in $ & 0<=v_4&v_4<=max($) & (v_4 in GOAL_4)) & (all1 v_5: v_5 in $ & 0<=v_5&v_5<=max($) => ~((v_5 in GOAL_5))) & (all1 v_6: v_6 in $ & 0<=v_6&v_6<=max($) => ~((v_6 in GOAL_6))));
